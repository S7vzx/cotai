# ── Front-end (Vite) — valores públicos ──────────────────────────────
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
VITE_SITE_URL=http://localhost:5173
# Chave PÚBLICA da AbacatePay (pk_..., Integração → Checkout próprio): mostra o formulário de cartão.
# Pode ficar no navegador. Sem ela, o cliente só vê Pix. Use a do mesmo ambiente da ABACATEPAY_API_KEY
VITE_ABACATEPAY_PUBLIC_KEY=

# ── Secrets das Edge Functions ───────────────────────────────────────
# Local: supabase/functions/.env  |  Produção: supabase secrets set NOME=valor
# Nunca coloque estes valores no front-end nem no banco.

SITE_URL=http://localhost:5173

# E-mail (Resend)
RESEND_API_KEY=
EMAIL_FROM=Cotaí <cotacoes@seudominio.com.br>

# WhatsApp — escolha um: zapi | evolution | meta | none
WHATSAPP_PROVIDER=none
ZAPI_INSTANCE=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=
EVOLUTION_URL=
EVOLUTION_KEY=
EVOLUTION_INSTANCE=
META_TOKEN=
META_PHONE_ID=

# Pagamento — escolha um: asaas | mercadopago | abacatepay | none
PAYMENT_PROVIDER=none
PAYMENT_ENV=sandbox
ASAAS_API_KEY=
MERCADOPAGO_ACCESS_TOKEN=
# AbacatePay: chave da API v2 (a de Dev mode para testes; a de produção depois). Mesma URL nos dois
ABACATEPAY_API_KEY=
# Na AbacatePay, cadastre este mesmo valor no campo Secret do webhook
PAYMENT_WEBHOOK_SECRET=
